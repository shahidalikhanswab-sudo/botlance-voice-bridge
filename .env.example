NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public HTTPS origin of the main BotLance app.
BOTLANCE_BASE_URL=https://botlance.app

# Shared service-to-service credential. Never expose this to Twilio or browsers.
BOTLANCE_BRIDGE_SERVICE_SECRET=replace_me

# Optional: used only if BotLance signs per-call bridge tokens with HMAC.
BOTLANCE_BRIDGE_TOKEN_SECRET=replace_me

# Provider runtime. The authoritative provider is still returned by BotLance bootstrap.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Production logging
LOG_LEVEL=info
