NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public HTTPS origin of the main BotLance app.
BOTLANCE_BASE_URL=https://botlance.app

# Shared service-to-service credential. Never expose this to Twilio or browsers.
BOTLANCE_BRIDGE_SERVICE_SECRET=replace_me

# Per-call bridge-token signing secret shared with the BotLance control plane.
BOTLANCE_BRIDGE_TOKEN_SECRET=replace_me

# Provider runtime credentials are NOT stored on Railway. BotLance mints
# short-lived per-call credentials from each tenant's existing BYOK setup.
# Gemini phone transport remains disabled until its adapter is implemented.
GEMINI_API_KEY=

# Production logging
LOG_LEVEL=info
